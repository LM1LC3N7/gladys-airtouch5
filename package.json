{
  "name": "gladys-airtouch5",
  "version": "0.1.0",
  "private": true,
  "description": "Gladys Assistant external integration for AirTouch 5 consoles (Polyaire): the ACs and zones of a ducted air-conditioning system (on/off, mode, fan speed, setpoint, damper opening, temperatures) over the local TCP protocol of the console. Unofficial, not affiliated with Polyaire.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
